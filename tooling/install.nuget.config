<?xml version="1.0" encoding="utf-8"?>
<!-- For installing the locally packed aspire-addon tool, and nothing else. Pass this file to
     `dotnet tool install -g AspireStarter.Addon` as its configfile; templating/README.md has the
     exact command. (An XML comment cannot contain a double hyphen, so the flags are not spelled
     out here.)

     Deliberately not named nuget.config. That name would be picked up by every restore under
     tooling/, and a local source that does not exist yet - artifacts/ is generated - fails restore on
     a clean clone. The add-source flag is no alternative: it refuses to run under package source
     mapping, which the workspace's nuget.config declares. The relative path below is resolved
     against this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-pack" value="../artifacts/nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-pack">
      <package pattern="AspireStarter.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
