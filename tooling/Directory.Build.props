<Project>

  <!-- Workspace-level tooling: the aspire-addon CLI and its tests. Never packed into a template and
       never listed in template.slnx. This file exists so MSBuild stops here rather than walking up
       into anything else. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
