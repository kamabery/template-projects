{
  // Which database container starts, and which EF provider template.api uses to talk to it - the
  // AppHost forwards this value to the API so the two cannot disagree. "postgres", "sqlserver" or
  // "sqlite"; override for one run with the Database__Provider environment variable. A scaffold has
  // this baked to the provider it asked for - the other branches are not present to switch to.
  "Database": {
    "Provider": "postgres"
  },
//#if (includeEventsMarten || includeEventsPolecat || includeEventsFisher)
  // Whether the optional event-sourcing slice joins the run. Off by default: on the postgres branch
  // it starts a second container for the event store, which nobody who only wants the base project
  // should pay for. Override for one run with the Events__Enabled environment variable.
  //
  // Which event store runs is not configured here - it follows Database:Provider above. Nothing
  // inside the events service reads Enabled; it decides only whether the AppHost declares the
  // resource at all.
  "Events": {
//#if (includeEventsPolecat)
    // How the events service publishes its integration event, and the only setting here the
    // service itself reads - the AppHost forwards it as Events__Transport. "local" uses Wolverine's
    // durable local queues, backed by the same SQL Server outbox tables, and starts no extra
    // container. "azureservicebus" starts the Service Bus emulator instead: two more containers,
    // one of them another SQL Server, and it requires accepting the emulator EULA.
    //
    // Declared before Enabled rather than after it so that removing this whole block when the
    // event store is not Polecat leaves valid JSON behind, with no trailing comma.
    "Transport": "local",
//#endif
    "Enabled": false
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
