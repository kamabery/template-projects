{
  // Which database container starts, and which EF provider template.api uses to talk to it - the
  // AppHost forwards this value to the API so the two cannot disagree. "postgres", "sqlserver" or
  // "sqlite"; override for one run with the Database__Provider environment variable. A scaffold has
  // this baked to the provider it asked for - the other branches are not present to switch to.
  "Database": {
    "Provider": "postgres"
  },
//#if (includeEvents)
  // Whether the optional Wolverine/Marten slice joins the run. Off by default: turning it on starts
  // a second Postgres container (events-pg) for the event store, which nobody who only wants the
  // base project should pay for. Override for one run with the Events__Enabled environment
  // variable. Nothing inside template.events reads this - it decides only whether the AppHost
  // declares the resource at all.
  "Events": {
    "Enabled": false
  },
//#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
