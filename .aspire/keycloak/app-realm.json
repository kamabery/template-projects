{
  "realm": "app",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "spa",
      "name": "Local front ends",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost*", "https://localhost*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost*##https://localhost*"
      },
      "protocolMappers": [
        {
          "name": "audience-spa",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "spa",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "qa",
      "email": "qa@example.test",
      "emailVerified": true,
      "firstName": "QA",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "qa", "temporary": false }]
    }
  ]
}
