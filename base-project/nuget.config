<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Clear inherited sources: the user/machine-level config includes a private
         Azure DevOps feed that 401s and blocks restore. Every package this repo
         needs is on nuget.org. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Written by `aspire init`, which requires an explicit mapping before it will resolve the
       AppHost SDK and hosting integrations. Redundant with the <clear/> above - nuget.org is the
       only source either way - but leave it: the Aspire CLI rewrites this file if it is missing. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
