@* Presentational only: it renders what it is given and owns no state. All state lives in the
   ViewModel, which is what lets this component be tested without DI or HTTP - including the unit,
   which arrives as a parameter rather than being read from PreferencesStore here.

   A plain <table> rather than FluentDataGrid on purpose. FluentDataGrid ships a JS module, and
   under bUnit's loose JSInterop an imported module resolves to null, so the component throws the
   moment it calls into it. See the note in Layout/NavMenu.razor. *@

@if (IsLoading)
{
    <div class="forecast-loading" data-testid="loading">
        <FluentProgressRing />
        <span>Loading the forecast...</span>
    </div>
}
else if (Forecasts.Count == 0)
{
    <p data-testid="empty">No forecast available.</p>
}
else
{
    <table class="forecast-table" data-testid="forecast-table">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col" class="numeric">Temp. (@UnitSuffix)</th>
                <th scope="col">Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in Forecasts)
            {
                <tr class="forecast-row" @key="forecast.Date">
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td class="numeric">@Temperature(forecast)</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<WeatherForecast> Forecasts { get; set; } = [];

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public TemperatureUnit Unit { get; set; } = TemperatureUnit.Celsius;

    private string UnitSuffix => Unit == TemperatureUnit.Celsius ? "C" : "F";

    private int Temperature(WeatherForecast forecast) =>
        Unit == TemperatureUnit.Celsius ? forecast.TemperatureC : forecast.TemperatureF;
}
