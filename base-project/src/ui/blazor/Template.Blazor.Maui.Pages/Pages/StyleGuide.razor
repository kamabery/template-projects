    // Demo state. A page, not a ViewModel: none of this outlives the guide, and routing it through
    // MVVM would only make the two style guides harder to compare.
    private string? CustomerName { get; set; }
    private string? Email { get; set; } = "ada@example.com";
    private string? Notes { get; set; }
    private string? Region { get; set; } = "Europe";
    private bool EmailMe { get; set; }
    private bool IncludeArchived { get; set; } = true;
    private bool ShowRetired { get; set; }
    private bool Notifications { get; set; } = true;
    private string Shipping { get; set; } = "standard";

    private string? LiveEmail { get; set; }
    private string? LiveEmailError =>
        string.IsNullOrEmpty(LiveEmail) || LiveEmail.Contains('@') ? null : "Enter an email address.";

    private string? SearchName { get; set; }
    private string? SearchRegion { get; set; }
    private bool SearchArchived { get; set; }
    private bool SearchSubmitted { get; set; }

    private string? SearchNameError =>
        SearchSubmitted && string.IsNullOrWhiteSpace(SearchName) ? "Enter a name to search for." : null;

    private string? SearchRegionError =>
        SearchSubmitted && string.IsNullOrWhiteSpace(SearchRegion) ? "Choose a region." : null;

    private string? DialogResult { get; set; }
    private bool CustomerDeleted { get; set; }

    // Page composition specimens. See docs/DESIGN.md section 4; the React guide poses the same
    // three sections over the same fabricated customers.
    private static readonly StyleGuideCustomer[] SpecimenCustomers =
    [
        new("ada", "Ada Lovelace", "Europe", 128, "4 Sep 2026", "Active", "Grace Hopper"),
        new("alan", "Alan Turing", "Europe", 94, "2 Sep 2026", "Active", "Grace Hopper"),
        new("katherine", "Katherine Johnson", "North America", 12, "17 Aug 2026", "Suspended", "Jean Bartik")
    ];

    private static readonly (string Label, string Value, string Qualifier, string Name)[] DashboardTiles =
    [
        ("Customers", "234", "18 added this week", "234 customers, 18 added this week"),
        ("Suspended", "12", "Needs review", "12 customers suspended, needs review"),
        ("Orders today", "41", "9 awaiting dispatch", "41 orders today, 9 awaiting dispatch")
    ];

    /// <summary>
    /// Which row the detail modal is open over. A field here ONLY because the guide is a single
    /// route: on a product screen this is a query parameter, so refresh, deep link, share and the
    /// back button all work. See Snippet24.
    /// </summary>
    private string? OpenCustomerId { get; set; }

    private string? DetailResult { get; set; }

    private async Task ShowInfoDialogAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Changes take effect immediately.",
            "Save",
            "Cancel",
            "Edit customer");

        var result = await dialog.Result;

        DialogResult = result.Cancelled ? "Cancelled" : "Saved";
    }

    private async Task OpenDetailAsync(
        StyleGuideCustomer customer,
        bool startInEdit = false,
        bool showSaveFailure = false)
    {
        // The row stays marked while the modal is up, so closing lands the eye where the click
        // started - the visual half of "focus returns to the row that opened it".
        OpenCustomerId = customer.Id;

        var dialog = await DialogService.ShowDialogAsync<StyleGuideDetailDialog>(
            new StyleGuideDetailRequest(customer, startInEdit, showSaveFailure),
            new DialogParameters { Title = customer.Name });

        var result = await dialog.Result;

        DetailResult = result.Cancelled ? "Closed" : "Saved";
        OpenCustomerId = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Their orders stay, but the customer record and its contact details are removed. This cannot be undone.",
            "Delete customer",
            "Cancel",
            "Delete Ada Lovelace?");

        var result = await dialog.Result;

        if (result.Cancelled)
        {
            return;
        }

        CustomerDeleted = true;
        ToastService.ShowError("Customer deleted.");
    }

    private void Search()
    {
        SearchSubmitted = true;

        if (SearchNameError is not null || SearchRegionError is not null)
        {
            return;
        }

        ToastService.ShowSuccess($"Searched {SearchRegion} for {SearchName}.");
    }

    private void ClearSearch()
    {
        SearchName = null;
        SearchRegion = null;
        SearchSubmitted = false;
    }
