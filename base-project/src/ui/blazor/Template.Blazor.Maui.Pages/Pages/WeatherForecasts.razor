@page "/weather"
@inherits ViewModelComponentBase<WeatherForecastViewModel>

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<FluentCard>
    @if (ViewModel.ErrorMessage is not null)
    {
        @* Wrapped in an element this library owns. FluentMessageBar does not forward arbitrary
           attributes to the DOM, so role/data-testid have to live on a real element for both
           assistive technology and tests to find them. *@
        <div role="alert" data-testid="error">
            <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">
                @ViewModel.ErrorMessage
            </FluentMessageBar>
        </div>
    }

    @* Setting ViewModel.Unit raises PropertyChanged, which is what re-renders this page - there is
       no StateHasChanged here for the same reason there is none anywhere else. *@
    <div class="unit-toggle" data-testid="unit-toggle">
        @foreach (var unit in Units)
        {
            <FluentButton Appearance="@(ViewModel.Unit == unit ? Appearance.Accent : Appearance.Neutral)"
                          aria-pressed="@(ViewModel.Unit == unit)"
                          OnClick="@(() => ViewModel.Unit = unit)">
                &deg;@(unit == TemperatureUnit.Celsius ? "C" : "F")
            </FluentButton>
        }
    </div>

    <WeatherForecastTable Forecasts="@ViewModel.Forecasts"
                          IsLoading="@ViewModel.IsLoading"
                          Unit="@ViewModel.Unit" />

    <FluentDivider />

    <FluentButton OnClick="@(() => ViewModel.LoadCommand.ExecuteAsync(null))" Disabled="@ViewModel.IsLoading">
        Reload
    </FluentButton>
</FluentCard>

@code {
    private static readonly TemperatureUnit[] Units = [TemperatureUnit.Celsius, TemperatureUnit.Fahrenheit];
}
