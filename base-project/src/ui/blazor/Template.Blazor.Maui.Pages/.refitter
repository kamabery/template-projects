{
  "openApiPath": "../../../../contracts/api.openapi.json",
  "namespace": "Template.Blazor.Maui.Pages.Providers",
  "outputFolder": "./Providers",
  "outputFilename": "ApiClient.generated.cs",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "Api"
