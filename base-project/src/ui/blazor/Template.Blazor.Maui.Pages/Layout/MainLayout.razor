@inherits LayoutComponentBase

@* No StorageName on FluentDesignTheme: it reads localStorage through JS interop, which needs
   FluentUI's loading-theme.js to avoid a flash of the wrong theme on first paint. Theme state is
   held in ThemeStore instead, which works identically in both hosts. *@
<FluentDesignTheme Mode="@(IsDarkTheme ? DesignThemeModes.Dark : DesignThemeModes.Light)" />

<FluentLayout>
    <FluentHeader>
        Template.Blazor.Maui
        <FluentSpacer />
        @* Bound to the instance property below, not to ThemeStore.IsDark directly: Blazor's
           FieldIdentifier rejects a ValueExpression over a STATIC member, and every FluentUI input
           builds one from its ValueExpression. *@
        <FluentSwitch @bind-Value="IsDarkTheme" />
    </FluentHeader>

    <FluentStack Class="main-stack" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <span>Shared components rendered from Template.Blazor.Maui.Pages</span>
    </FluentFooter>
</FluentLayout>

@* FluentToastProvider / FluentDialogProvider / FluentTooltipProvider are deliberately absent.
   Add the one you need when you start using its service - each pulls in a JS module, which the
   MAUI host loads through _framework/blazor.modules.json. See the note in that host's
   wwwroot/index.html before touching its script tags. *@

@code {
    private bool IsDarkTheme
    {
        get => ThemeStore.IsDark;
        set => ThemeStore.IsDark = value;
    }
}
