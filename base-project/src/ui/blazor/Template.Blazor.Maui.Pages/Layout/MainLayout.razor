@inherits LayoutComponentBase
@implements IDisposable

@* Page-view spans. Started here because this layout wraps every page in both hosts, so one
   subscription covers all of them - and it is inert until a TracerProvider is listening, which is
   why no enabled check is needed. See Telemetry/NavigationTelemetry.cs. *@
@inject NavigationTelemetry Navigation

@* No StorageName on FluentDesignTheme: it reads localStorage through JS interop, which needs
   FluentUI's loading-theme.js to avoid a flash of the wrong theme on first paint. Theme state is
   held in ThemeStore instead, which works identically in both hosts. *@
<FluentDesignTheme Mode="@(IsDarkTheme ? DesignThemeModes.Dark : DesignThemeModes.Light)" />

<FluentLayout>
    <FluentHeader>
        Template.Blazor.Maui
        <FluentSpacer />
        @* Bound to the instance property below, not to ThemeStore.IsDark directly: Blazor's
           FieldIdentifier rejects a ValueExpression over a STATIC member, and every FluentUI input
           builds one from its ValueExpression. *@
        <FluentSwitch @bind-Value="IsDarkTheme" />
    </FluentHeader>

    <FluentStack Class="main-stack" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>

    <FluentFooter>
        <span>Shared components rendered from Template.Blazor.Maui.Pages</span>
    </FluentFooter>
</FluentLayout>

@* Two of FluentUI's three providers, present because the style guide's Dialog and Toast
   sections use their services and nothing renders without them. Each pulls in a JS module, which
   both hosts load through _framework/blazor.modules.json - see the note in the MAUI host's
   wwwroot/index.html, which records that the module manifest already covers this and no script tag
   change is needed.

   Under bUnit an imported module resolves to null, so FluentUiTestContext stubs the ones these
   register. FluentTooltipProvider stays absent: nothing uses ITooltipService yet, and an unused
   provider is a JS module and a stub for no return. *@
<FluentDialogProvider />
<FluentToastProvider />

@code {
    private bool IsDarkTheme
    {
        get => ThemeStore.IsDark;
        set => ThemeStore.IsDark = value;
    }

    protected override void OnInitialized() => Navigation.Start();

    public void Dispose() => Navigation.Dispose();
}
