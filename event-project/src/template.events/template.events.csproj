<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Marten / PostgreSQL event-store host. One of three siblings - see
       template.events.polecat (SQL Server) and template.events.fisher (SQLite) - which exist
       separately because a project may reference exactly one event store. The store-agnostic code
       they all share is linked in from src/shared/.

       AssemblyName and RootNamespace are pinned rather than defaulted from the file name.
       Scaffolding renames files using the new project name verbatim, but rewrites file *contents*
       using the casing of the token it matched - and the prefix here is lowercase. Without these
       pins, assembly identity and namespace would disagree in a scaffolded project. -->
  <PropertyGroup>
    <AssemblyName>template.events</AssemblyName>
    <RootNamespace>template.events</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Marten" />
    <!-- Registers the Roslyn code generator Wolverine's default TypeLoadMode.Dynamic needs; core
         WolverineFx stopped shipping it in v6. Auto-registers on reference, so nothing in the
         source names it - do not prune it as an unused dependency. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- The transport, selected by Events:Transport in src/shared/Messaging/ServiceBusTransport.cs.
         Referenced unconditionally because both branches are live code; it costs nothing until
         the configuration selects it. -->
    <PackageReference Include="WolverineFx.AzureServiceBus" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!-- src/shared/ is linked source, not a referenced assembly, and that is load-bearing.
         JasperFx.Events emits an aggregate's Apply/Create dispatcher with a compile-time source
         generator, and the type it emits is the store's own closed generic - so the aggregate and
         the event store have to be in the SAME compilation. A shared class library would give the
         generator Widget but no store, and FetchForWriting<Widget> would then throw
         InvalidProjectionException on the first command, after a clean build and a green test run.
         See src/shared/README.md. -->
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reaches up and out of event-project/ on purpose: this is a sibling of base-project/, and
         AddServiceDefaults is what supplies /health, OpenTelemetry and Serilog. Staging folds the
         events slice into src/ and rewrites this to a normal sibling path. The cost is that
         event-project/ is not independently packable while this reference exists. -->
    <ProjectReference Include="..\..\..\base-project\src\template.servicedefaults\template.servicedefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>template.events.tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
