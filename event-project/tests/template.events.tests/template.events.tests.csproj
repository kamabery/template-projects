<Project Sdk="Microsoft.NET.Sdk">

  <!-- AssemblyName and RootNamespace are pinned rather than defaulted from the file name.
       Scaffolding renames files using the new project name verbatim, but rewrites file *contents*
       using the casing of the token it matched - and the prefix here is lowercase. Without these
       two properties the assembly would take the file name's casing while every string naming it
       took the lowercase form, which is exactly the mismatch that breaks InternalsVisibleTo. -->
  <PropertyGroup>
    <AssemblyName>template.events.tests</AssemblyName>
    <RootNamespace>template.events.tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <!-- For src/shared/Messaging, which names a transport but no event store. -->
    <PackageReference Include="WolverineFx.AzureServiceBus" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="AutoFixture" />
    <PackageReference Include="AutoFixture.Xunit2" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The store-free half of src/shared/, linked rather than referenced - deliberately NOT one
         of the three event-store hosts. Everything worth unit testing is in here, and referencing a
         host would tie this suite to one store while leaving the other two uncovered. Domain/,
         Contracts/ and Messaging/ are the subset that names no ASP.NET or event-store type. -->
    <Compile Include="..\..\src\shared\Domain\**\*.cs" LinkBase="Shared\Domain" />
    <Compile Include="..\..\src\shared\Contracts\**\*.cs" LinkBase="Shared\Contracts" />
    <Compile Include="..\..\src\shared\Messaging\**\*.cs" LinkBase="Shared\Messaging" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
